{
  "expo": {
    "name": "tuna-bassoon-app",
    "slug": "tuna-bassoon-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tunabassoonapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.dffallonsteam.tunabassoonapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
"plugins": [
  "expo-router",
  [
    "expo-location",
    {
      "locationWhenInUsePermission": "Tuna Bassoon uses your location to show your position on the map."
    }
  ],
  "@maplibre/maplibre-react-native",
  "expo-image",
  "expo-web-browser",
  "expo-secure-store",
  "@clerk/expo"
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2d90362-c546-4f55-89e2-2b246431ace2"
      }
    }
  }
}