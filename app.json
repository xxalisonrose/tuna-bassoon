{
  "expo": {
    "name": "Lorcal",
    "slug": "tuna-bassoon-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tunabassoonapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dffallonsteam.tunabassoonapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.Lorcalapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lorcal uses your location to show your position on the map."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Lorcal lets you choose screenshots to attach to beta feedback."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "@clerk/expo",
      "@clerk/expo-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2d90362-c546-4f55-89e2-2b246431ace2"
      }
    }
  }
}
